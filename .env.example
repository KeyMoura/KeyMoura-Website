# Public deployment identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project API settings (anon access must be protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ or expose to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Independent HMAC key for guest order verification codes (32+ random bytes).
GUEST_ORDER_VERIFICATION_SECRET=replace-with-an-independent-random-secret

# Optional commerce integrations. The site continues to work without them.
RESEND_API_KEY=re_your-api-key
ORDER_EMAIL_FROM=KeyMoura <orders@keymoura.com>
ORDER_NOTIFICATION_EMAIL=ethan@keymoura.com
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
# Build-time only; keep this server-side and never prefix it with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=sntrys_your-source-map-upload-token

# Server-only one-time installer unlock secret (minimum 24 random characters).
# Generate with: openssl rand -base64 32
INSTALL_TOKEN=replace-with-a-long-random-secret

# Optional server-only direct connection used only by the trusted bootstrap CLI.
# Never expose this through NEXT_PUBLIC_* or enter it in the web installer.
SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
