# Public deployment identity
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project API settings (anon access must be protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix with NEXT_PUBLIC_ or expose to client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only one-time installer unlock secret (minimum 24 random characters).
# Generate with: openssl rand -base64 32
INSTALL_TOKEN=replace-with-a-long-random-secret

# Optional server-only direct connection used only by the trusted bootstrap CLI.
# Never expose this through NEXT_PUBLIC_* or enter it in the web installer.
SUPABASE_DB_URL=postgresql://postgres:password@db.project.supabase.co:5432/postgres
